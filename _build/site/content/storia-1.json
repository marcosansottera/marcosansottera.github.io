mn":1}},"key":"PeXIfK2br6"}],"identifier":"colossus-mark-i-ii","label":"Colossus Mark I/II","html_id":"colossus-mark-i-ii","implicit":true,"key":"cuiChrwE9U"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Il ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"lfs70dcpNn"},{"type":"link","url":"https://it.wikipedia.org/wiki/Colossus","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Colossus","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"tDVkAYHzFh"}],"urlSource":"https://it.wikipedia.org/wiki/Colossus","data":{"page":"Colossus","wiki":"https://it.wikipedia.org/","lang":"it"},"internal":false,"protocol":"wiki","key":"aNRHZToTEU"},{"type":"text","value":" è stato uno dei\nprimi computer elettronici programmabili nella storia\ndell’informatica. Costruito e messo in opera nel Regno Unito, durante\nla seconda guerra mondiale, fu in grado di decifrare i codici\nsviluppati dalla cifratrice Lorenz SZ 40/42 usata dai nazisti per\nproteggere la corrispondenza fra Adolf Hitler e i suoi capi di stato\nmaggiore, oltre che alle comunicazioni Purple e Red giapponesi, basate\nsulla tecnologia di Enigma. I servizi segreti britannici fecero di\ntutto per interpretare i codici dei nazisti, che però venivano\ncambiati quotidianamente.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"sYIVJWVknD"}],"key":"mO02VtbqOA"},{"type":"heading","depth":3,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"ENIAC","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"yfY9dkr1lP"}],"identifier":"eniac","label":"ENIAC","html_id":"eniac","implicit":true,"key":"TDhnXfsEKf"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"t